    {
      "name": "plain id",
      "input": "user-42",
      "expected": "user-42"
    },
    {
      "name": "numeric short id",
      "input": "12345",
      "expected": "12345"
    },
    {
      "name": "UUID id",
      "input": "3f2b8c1e-6a4d-4e2f-9b7a-1c5d8e9f0a2b",
      "expected": "3f2b8c1e-6a4d-4e2f-9b7a-1c5d8e9f0a2b"
    },
    {
      "name": "id with surrounding spaces is kept as given",
      "input": "  user-42 ",
      "expected": "  user-42 "
    },
    {
      "name": "single space",
      "input": " ",
      "expected": " "
    },
    {
      "name": "empty string is rejected",
      "input": "",
      "expected": null
    },
    {
      "name": "e-mail",
      "input": "user@example.com",
      "expected": "b4c9a289323b21a01c3e940f150eb9b8c542587f1abfd8f0e1cc1ffc5e475514"
    },
    {
