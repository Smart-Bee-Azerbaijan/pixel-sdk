{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c.cdnsb.net/spec/config.v1.schema.json",
  "title": "SmartBee Pixel source config v1",
  "type": "object",
  "required": ["v", "key", "rev", "enabled"],
  "properties": {
    "v": { "const": 1 },
    "key": { "type": "string", "pattern": "^[a-z0-9]{8,16}$" },
    "rev": { "type": "integer", "minimum": 0 },
    "enabled": { "type": "boolean" },
    "sample": { "type": "number", "minimum": 0, "maximum": 1 },
    "ttl_s": { "type": "integer", "minimum": 60 },
    "sdk_latest": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "session_timeout_s": { "type": "integer", "minimum": 60 },
    "consent_default": {
      "type": "object",
      "properties": {
        "analytics": { "type": "boolean" },
        "ads": { "type": "boolean" }
      }
    },
    "auto": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "blocked_events": { "type": "array", "items": { "type": "string" } },
    "strip_params": { "type": "array", "items": { "type": "string" } },
    "flush": {
      "type": "object",
      "properties": {
        "interval_s": { "type": "integer", "minimum": 1 },
        "max_batch": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_queue": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": { "type": "array", "items": { "type": "object", "required": ["id"] } }
  }
}
