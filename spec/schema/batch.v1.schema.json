{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c.cdnsb.net/spec/batch.v1.schema.json",
  "title": "SmartBee Pixel event batch v1",
  "type": "object",
  "required": ["v", "key", "sent_at", "sdk", "ctx", "events"],
  "properties": {
    "v": { "const": 1 },
    "key": { "$ref": "#/$defs/key" },
    "sent_at": { "$ref": "#/$defs/timestamp" },
    "sdk": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "wrapper": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "wrapper_version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "ctx": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "locale": { "type": "string", "maxLength": 35 },
        "tz": { "type": "string", "maxLength": 64 },
        "ua": { "type": "string", "maxLength": 1024 },
        "screen": {
          "type": "object",
          "properties": {
            "w": { "type": "integer", "minimum": 0 },
            "h": { "type": "integer", "minimum": 0 },
            "density": { "type": "number", "minimum": 0 }
          }
        },
        "consent": { "$ref": "#/$defs/consent" },
        "campaign": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 512 } },
        "ids": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 256 } },
        "app": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "version": { "type": "string", "maxLength": 64 },
            "build": { "type": "string", "maxLength": 64 }
          }
        },
        "os": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 32 },
            "version": { "type": "string", "maxLength": 32 }
          }
        },
        "device": {
          "type": "object",
          "properties": {
            "manufacturer": { "type": "string", "maxLength": 64 },
            "model": { "type": "string", "maxLength": 64 },
            "type": { "type": "string", "maxLength": 16 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9]{8,16}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "consent": {
      "type": "object",
      "properties": {
        "analytics": { "type": "boolean" },
        "ads": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "ts", "anon_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "anon_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "user_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "session_id": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": 0 },
        "origin": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
        "rule_id": { "$ref": "#/$defs/id" },
        "props": { "type": "object" },
        "traits": { "type": "object" },
        "page": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "maxLength": 2048 },
            "referrer": { "type": "string", "maxLength": 2048 },
            "title": { "type": "string", "maxLength": 512 }
          }
        },
        "screen": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 128 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "track" } }, "required": ["type"] },
          "then": { "required": ["name"] }
        },
        {
          "if": { "properties": { "type": { "const": "identify" } }, "required": ["type"] },
          "then": { "required": ["user_id"] }
        }
      ]
    }
  }
}
